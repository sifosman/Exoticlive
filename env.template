# WordPress/WooCommerce Configuration
# Copy this file to .env.local and fill in your values

# WordPress site URL (required)
# Example: https://wp.exoticshoes.co.za
NEXT_PUBLIC_WORDPRESS_URL=

# WooCommerce API Keys (required)
# Generate these in WooCommerce > Settings > Advanced > REST API
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Yoco Payment Gateway Configuration (required)
# Get these from your Yoco dashboard at https://portal.yoco.com
# IMPORTANT: Use the secret key WITHOUT the NEXT_PUBLIC_ prefix for security
YOCO_SECRET_KEY=sk_live_your_secret_key_here
NEXT_PUBLIC_YOCO_PUBLIC_KEY=pk_live_your_public_key_here
